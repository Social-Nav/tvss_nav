<launch>
  <!-- rosbridge -->
  <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch" />

  <!-- <node pkg="nodelet" type="nodelet" name="depth_to_cloud" args="standalone depth_image_proc/point_cloud_xyz">
    <remap from="image_rect" to="/camera/aligned_depth_to_color/image_raw"/>
    <remap from="camera_info" to="/camera/color/camera_info"/>
    <remap from="points" to="/depth_cloud"/>
  </node> -->

  <!-- pointcloud_seg -->
  <include file="$(find pointcloud_seg)/launch/pointcloud_seg.launch">
    <arg name="pointcloud_topic" value="/camera/depth/color/points" />
    <arg name="mask_topic" value="/segmented_image/mask" />
    <arg name="rgb_info_topic" value="/camera/color/camera_info" />
    <arg name="depth_info_topic" value="/rto/d415/depth/camera_info" />
  </include>

  <!-- cloud2costmap -->
  <node pkg="tvss_nav" type="cloud2costmap.py" name="costmap_updater" output="screen" launch-prefix="/usr/bin/python3.8">
    <param name="map_frame" value="map" />
    <param name="costmap_topic" value="/rto/move_base_flex/global_costmap/costmap" />
    <param name="output_topic" value="/rto/move_base_flex/global_costmap/semantic_costmap" />
    <param name="cloud_prefix" value="/segmented_cloud/" />
    <param name="min_height" value="0.1" />
    <param name="max_height" value="2.0" />
    <param name="min_distance" value="0.1" />
    <param name="max_distance" value="10.0" />
    <param name="cleanup_threshold" value="2.0" />
  </node>
</launch>
